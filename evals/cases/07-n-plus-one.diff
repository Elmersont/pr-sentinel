@@ -3,3 +3,9 @@ import { db } from '../db';
 export async function teamReport(teamId: string) {
   const members = await db.query('SELECT id, name FROM members WHERE team_id = $1', [teamId]);
+  const rows = [];
+  for (const m of members) {
+    const tasks = await db.query('SELECT COUNT(*) AS c FROM tasks WHERE assignee_id = $1', [m.id]);
