{
  "name": "pr-sentinel",
  "version": "0.2.0",
  "description": "LLM-powered pull request reviewer as a GitHub Action: structured findings, grounded line references, secret redaction, Jira/Teams hooks and a built-in eval suite.",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Elmerson Torres Deza",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "review": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts",
    "e2e": "tsx e2e/run.ts"
  },
  "keywords": [
    "github-action",
    "code-review",
    "llm",
    "ai",
    "pull-request",
    "developer-experience"
  ],
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@vercel/ncc": "^0.45.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
